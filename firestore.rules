rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function dono(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function pessoaDoRequisitante() {
      return get(/databases/$(database)/documents/pessoas/$(request.auth.uid)).data;
    }

    function isDiretoria() {
      return autenticado()
        && exists(/databases/$(database)/documents/pessoas/$(request.auth.uid))
        && pessoaDoRequisitante().status == 'ativo'
        && pessoaDoRequisitante().papel == 'diretoria';
    }

    function isParceiro() {
      return autenticado()
        && exists(/databases/$(database)/documents/pessoas/$(request.auth.uid))
        && pessoaDoRequisitante().status == 'ativo'
        && pessoaDoRequisitante().papel == 'parceiro';
    }

    function camposNaoAlterados(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    function podeRegistrarArvoresDoRequisitante() {
      return autenticado()
        && exists(/databases/$(database)/documents/pessoas/$(request.auth.uid))
        && pessoaDoRequisitante().status == 'ativo'
        && pessoaDoRequisitante().podeRegistrarArvores == true;
    }

    // Troca de senha provisória: o próprio dono só pode virar senhaProvisoria
    // de true para false, e nada mais pode mudar nessa mesma operação.
    function trocaSenhaProvisoria() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senhaProvisoria'])
        && resource.data.senhaProvisoria == true
        && request.resource.data.senhaProvisoria == false;
    }

    match /pessoas/{uid} {
      allow read: if dono(uid) || isDiretoria();

      allow create: if dono(uid)
        && request.resource.data.status == 'pendente'
        && request.resource.data.papel == null;

      // O próprio usuário só edita dados de contato; status/papel/cpf/tipoPessoa/dataInscricao/
      // senhaProvisoria são intocáveis por essa via (senhaProvisoria só muda por trocaSenhaProvisoria()).
      allow update: if isDiretoria()
        || (dono(uid) && trocaSenhaProvisoria())
        || (dono(uid) && camposNaoAlterados(['status', 'papel', 'cpf', 'tipoPessoa', 'dataInscricao', 'uid', 'senhaProvisoria']));

      allow delete: if isDiretoria();
    }

    // Espelho público restrito de pessoas/{uid} (nome, fotoUrl, status, papel),
    // usado pela credencial digital e sua validação por QR code.
    match /credenciais/{uid} {
      allow read: if isParceiro() || isDiretoria();

      // Escrita só acontece via sincronização client-side feita pelo próprio
      // dono do documento (perfil) ou pela diretoria (aprovação/status/papel);
      // um parceiro nunca escreve aqui.
      allow write: if dono(uid) || isDiretoria();
    }

    match /cards/{cardId} {
      allow read: if true;
      allow write: if isDiretoria();
    }

    // Sincronizados pela Cloud Function a partir do Google Calendar; o Admin SDK
    // ignora as regras, então nenhum client (nem a diretoria) escreve aqui.
    match /eventos/{eventoId} {
      allow read: if resource.data.visibilidade == 'publico' || isDiretoria();
      allow write: if false;
    }

    match /mensagens/{mensagemId} {
      allow read: if autenticado() && (resource.data.remetenteUid == request.auth.uid || isDiretoria());

      allow create: if dono(request.resource.data.remetenteUid)
        && request.resource.data.status == 'nova'
        && request.resource.data.isTarefa == false
        && request.resource.data.responsavelUid == null
        && request.resource.data.retorno == null;

      // Diretoria só altera campos de gestão (isTarefa, status, responsavel*,
      // retorno, dataRetorno, historico); conteúdo original do associado é intocável.
      allow update: if isDiretoria()
        && camposNaoAlterados(['remetenteUid', 'remetenteNome', 'assunto', 'texto', 'dataEnvio']);

      allow delete: if false; // nunca apagar, só mudar status
    }

    // Cadastro completo (CNPJ, responsável, histórico de aprovação) — só a diretoria acessa.
    match /estabelecimentos/{id} {
      allow read, write: if isDiretoria();
    }

    // Espelho público do selo "Amigo do Bairro" (mesmo id de estabelecimentos/{id}),
    // sem CNPJ/responsável/histórico. Leitura pública segue o mesmo padrão de cards/eventos.
    match /estabelecimentosPublicos/{id} {
      allow read: if true;
      allow write: if isDiretoria();
    }

    match /criteriosAmigoBairro/{id} {
      allow read, write: if isDiretoria();
    }

    match /arvores/{arvoreId} {
      allow create: if (isDiretoria() || podeRegistrarArvoresDoRequisitante())
        && request.resource.data.uid == request.auth.uid;
      allow read: if autenticado();

      // uid/geoponto/precisaoGpsMetros/criadoEm são imutáveis após a criação.
      // 'fotos' e 'moderacao' ficam de fora para permitir reclassificação de
      // tipo de foto e validação de espécie pela diretoria na moderação.
      // Quem só tem podeRegistrarArvores altera apenas o que uma visita de
      // monitoramento reflete na árvore (estado atual, última visita, remoção),
      // e não pode desfazer uma remoção (correção só pela diretoria/Console).
      allow update: if (isDiretoria() && camposNaoAlterados(['uid', 'geoponto', 'precisaoGpsMetros', 'criadoEm']))
        || (podeRegistrarArvoresDoRequisitante()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'ultimaVisitaEm', 'situacao', 'removidaEm'])
            && (resource.data.get('situacao', 'ativa') != 'removida'
                || request.resource.data.get('situacao', 'ativa') == 'removida'));

      allow delete: if isDiretoria();

      // Visitas de monitoramento: sem moderação e imutáveis (correção = nova visita).
      match /visitas/{visitaId} {
        allow read: if autenticado();

        allow create: if (isDiretoria() || podeRegistrarArvoresDoRequisitante())
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.ocorrencias is list
          && request.resource.data.fotos is list
          && request.resource.data.fotos.size() <= 3
          && (!('removida' in request.resource.data.ocorrencias)
              || request.resource.data.fotos.size() >= 1);

        allow update: if false;

        // Só para excluirArvore (cadastro feito por engano).
        allow delete: if isDiretoria();
      }
    }
  }
}
